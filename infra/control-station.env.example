# Copy to /etc/lr-platform/platform.env on the control-station computer.
# This file contains deployment configuration; keep passwords and certificate
# paths out of Git. Do not put it on the robot computer.
LR_PLATFORM_MODE=production

# A human-readable name shown in operator software, a unique appliance ID and
# the one canonical HTTPS origin. The host/IP in this URL must exist in web.crt
# Subject Alternative Names and should also be used by robots' MQTT settings.
LR_STATION_NAME=图书馆机器人控制站
LR_STATION_ID=replace-with-a-generated-station-id
LR_STATION_URL=https://control-station.example

# Browser origin served by the control station. Comma-separate additional
# trusted origins only when required.
LR_CORS_ORIGINS=https://control-station.example

# Keep the HTTP listener local; user browsers use the TLS port below.
LR_WEB_BIND_ADDRESS=127.0.0.1
LR_WEB_PORT=8000
LR_WEB_TLS_BIND_ADDRESS=0.0.0.0
LR_WEB_TLS_PORT=443
LR_API_BIND_ADDRESS=127.0.0.1
LR_API_PORT=8080
LR_MQTT_BIND_ADDRESS=127.0.0.1
LR_MQTT_PORT=1883
LR_MQTT_TLS_BIND_ADDRESS=0.0.0.0
LR_MQTT_TLS_PORT=8883
LR_EMQX_DASHBOARD_BIND_ADDRESS=127.0.0.1
LR_EMQX_DASHBOARD_PORT=18083

# Use independent generated passwords. The certificate directory must contain
# ca.crt, server.crt, server.key, control-api.crt and control-api.key.
LR_POSTGRES_PASSWORD=replace-before-production
LR_MINIO_ROOT_PASSWORD=replace-before-production
LR_EMQX_DASHBOARD_USERNAME=replace-admin-user
LR_EMQX_DASHBOARD_PASSWORD=replace-before-production
LR_EMQX_NODE_COOKIE=replace-with-a-random-node-cookie
LR_MQTT_USERNAME=lr-control-api
LR_MQTT_PASSWORD=replace-with-the-control-api-mqtt-password
LR_MQTT_CERTS_DIR=/etc/lr-platform/mqtt-certs
LR_WEB_TLS_CERTS_DIR=/etc/lr-platform/web-certs
LR_EMQX_BOOTSTRAP_USERS_FILE=/etc/lr-platform/emqx-users.csv
LR_CRUISE_POINTS_FILE_HOST=/etc/lr-platform/cruise-points.yaml
# 巡航点注入默认关闭；部署好上面的批准副本后才打开。
LR_CRUISE_POINTS_ENABLED=false
