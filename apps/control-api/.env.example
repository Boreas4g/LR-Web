LR_ENVIRONMENT=development
LR_STATION_NAME=LR 控制站
LR_STATION_ID=development-station
# Production requires the canonical HTTPS origin used by the appliance and
# the discovery service, for example https://control-station.example.
LR_STATION_URL=
LR_HOST=0.0.0.0
LR_PORT=8080
LR_CORS_ORIGINS=http://localhost:8000
# auto: use PostgreSQL when LR_DATABASE_URL is set, otherwise use memory.
LR_STORAGE_BACKEND=auto
# Local all-in-one development keeps the existing robot-workspace path.
# Production Compose overrides this with the control-station-owned snapshot.
LR_CRUISE_POINTS_FILE=/home/boreas/Library_robot/src/robot_decision/config/points.yaml
LR_DATABASE_URL=postgresql+psycopg://library_robot:change-me-before-production@localhost:5432/library_robot
LR_REDIS_URL=redis://localhost:6379/0
LR_MQTT_URL=mqtt://localhost:1883
LR_MQTT_USERNAME=
LR_MQTT_PASSWORD=
LR_MQTT_TLS_ENABLED=false
LR_MQTT_CA_FILE=
LR_MQTT_CLIENT_CERT_FILE=
LR_MQTT_CLIENT_KEY_FILE=
# Set true in production so a disconnected MQTT broker rejects commands.
LR_REQUIRE_MQTT=false
